{
  "info": {
    "name": "catalog — Auth",
    "description": "Tokens para la colección de API. Ejecuta primero las requests de esta colección: cada una guarda su token en una global (token_<rol>, token_<cliente>). Las variables son del stack, no del diseño: rellénalas según tu proveedor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Token — catalog-admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{tokenUrl}}",
        "description": "Token de usuario con el rol catalog-admin. Permisos: product:read, product:write, product:delete, taxonomy:write.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            },
            {
              "key": "username",
              "value": "{{username_catalog-admin}}"
            },
            {
              "key": "password",
              "value": "{{password_catalog-admin}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "pm.globals.set('token_catalog-admin', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
