{
  "info": {
    "name": "catalog — autenticación",
    "description": "Obtiene un token por rol y por cliente máquina y los deja en globals (token_<rol>). `no-role` es un usuario autenticado sin ningún rol del catálogo; `other-audience` es un cliente cuyo token se emite para otra audiencia. El endpoint de token y las credenciales son del proveedor de identidad del despliegue: rellena las variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Token — catalog-manager",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{tokenUrl}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            },
            {
              "key": "username",
              "value": "{{username_catalog-manager}}"
            },
            {
              "key": "password",
              "value": "{{password_catalog-manager}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "pm.globals.set('token_catalog-manager', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
