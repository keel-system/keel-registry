{
  "info": {
    "name": "payment — tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Token — checkout (client_credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{tokenUrl}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "{{clientId_checkout}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret_checkout}}"
            },
            {
              "key": "scope",
              "value": "{{scope_checkout}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "pm.globals.set('token_checkout', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
