    {
      "name": "Token M2M — billing (notification:send message:read)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{tokenUrl}}",
        "description": "Consumidor de facturación; pide envíos de notificación transaccional y consulta el desenlace de los suyos.  El claim `aud` del token debe nombrar a `notifications`: el servicio valida la audiencia y responde 403 si no coincide.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "{{clientId_billing}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret_billing}}"
            },
            {
              "key": "scope",
              "value": "{{scopes_billing}}"
            },
            {
              "key": "audience",
              "value": "notifications"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "pm.globals.set('token_billing', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
