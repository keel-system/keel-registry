{
  "info": {
    "name": "notifications — auth",
    "description": "Tokens por rol y por cliente máquina. Las variables las rellena el environment que emite el generador para su proveedor de identidad.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Token — notifications-admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{tokenUrl}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            },
            {
              "key": "username",
              "value": "{{username_notifications-admin}}"
            },
            {
              "key": "password",
              "value": "{{password_notifications-admin}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token 200', () => pm.response.to.have.status(200));",
              "pm.globals.set('token_notifications-admin', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
