            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "client_secret",
              "value": "{{clientSecret}}"
            },
            {
              "key": "username",
              "value": "{{username_notifications-auditor}}"
            },
            {
              "key": "password",
              "value": "{{password_notifications-auditor}}"
            }
